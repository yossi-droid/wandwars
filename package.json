{
  "name": "wandwars",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A fresh browser game built with Vite, with a full local + CI quality gate.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "verify": "npm run format:check && npm run lint && npm run test:unit && npm run build",
    "check": "npm run verify && npm run test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@playwright/test": "^1.48.0",
    "eslint": "^9.13.0",
    "globals": "^15.11.0",
    "prettier": "^3.3.3",
    "vite": "^6.0.0",
    "vitest": "^2.1.4"
  },
  "dependencies": {
    "three": "^0.185.1"
  }
}
